# Moving API keys and other sensitive information to a .env file for better security and management
# Separation of sensitve configuration data from application source code.
Email_Notification_API_KEY="#########################"  # API KEY

# .env.example STMP-STYLE varaibles file for email notification configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com